# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather
# Optional: restrict bot to your Telegram user IDs (comma separated). Empty = allow all.
# Get your ID from @userinfobot
ALLOWED_USER_IDS=

# --- InfiniCloud WebDAV ---
# Find it in My Page. Example: https://abcd1234.infini-cloud.net/dav/
# Must end with /
WEBDAV_URL=https://XXXX.infini-cloud.net/dav/
WEBDAV_USERNAME=your-infinicloud-user-id
WEBDAV_PASSWORD=your-infinicloud-password
# Optional subfolder inside WebDAV, e.g. Telegram/ . Empty = root.
WEBDAV_DIR=

# --- Uploads ---
# How many links may upload at the same time. Default 3.
# Raise only if your connection has the bandwidth.
MAX_CONCURRENT_UPLOADS=3
# How many links are taken from a single message. Default 10.
MAX_LINKS_PER_MESSAGE=10
# Seconds the WebDAV socket may make ZERO write progress before the upload is
# aborted. requests has no separate write timeout: the FIRST element of its
# timeout tuple is what governs socket writes, so this is the value that
# actually kills long uploads. Default 600 (10 min).
STALL_TIMEOUT=600
# Seconds the source server may stall mid-download before we give up.
# This one IS a real read timeout. Default 60.
SOURCE_READ_TIMEOUT=60

# --- Housekeeping / cleanup ---
# Files younger than CLEAN_MIN_FREE_SECS may still be uploading, never touched.
# CLEAN_MAX_AGE_HOURS gates the weak (circumstantial) orphan signals only.
CLEAN_MAX_AGE_HOURS=24
CLEAN_MIN_FREE_SECS=60
# 1 = also delete weak suspects (tiny _N duplicates, long-dead zero-byte files).
# 0 = only delete orphans proven by a job record.
CLEAN_WEAK=1
CLEAN_MAX_DELETES=200
# Log rotation (used when the bot is started with --log)
LOG_MAX_BYTES=5242880
LOG_BACKUPS=3
# jobs.jsonl is compacted automatically once it exceeds this size.
JOB_LOG_MAX_BYTES=20971520
JOB_LOG_KEEP=5000
